# Copy to server/.env for local development. Never commit real values.
# production | development | test
NODE_ENV=development
PORT=8787
# Listen address; 0.0.0.0 to reach a dev API from another device on the LAN
HOST=127.0.0.1
# Frontend origin allowed by CORS
APP_ORIGIN=http://localhost:5173
# At least 32 random characters in production (e.g. `openssl rand -base64 48`)
JWT_SECRET=
# cookie (site and API on one domain) or body (no shared domain)
REFRESH_TRANSPORT=body
# Public site address for links in letters, if it differs from APP_ORIGIN (e.g. has a path)
APP_URL=
# Resend key and sender. Empty locally: letters are written to the log
RESEND_API_KEY=
MAIL_FROM=
# true behind a reverse proxy (the client address then comes from X-Forwarded-For)
TRUST_PROXY=false
# postgres://user:password@host:5432/db — leave empty locally to use PGlite in server/.data
DATABASE_URL=
# DeepSeek key; empty — the AI helper is off
DEEPSEEK_API_KEY=
# AI limits: requests per learner per day, tokens per month for the whole site
AI_DAILY_REQUESTS=30
AI_MONTHLY_TOKENS=5000000
